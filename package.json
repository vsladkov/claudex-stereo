{
  "name": "claudex-stereo",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Use Codex from Claude Code to review code or delegate tasks.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bump-version": "node scripts/bump-version.ts",
    "check-version": "node scripts/bump-version.ts --check",
    "provider-probe": "node scripts/provider-probe.ts",
    "test": "node --test --require ./tests/env-bootstrap.cjs --test-global-setup=./tests/global-setup.ts \"tests/*.test.ts\"",
    "pretypecheck": "node -e \"fs.mkdirSync(process.argv[1], {recursive: true})\" .generated/app-server-types && codex app-server generate-ts --out .generated/app-server-types",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
