{
  "name": "claudex-stereo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Use Codex from Claude Code to review code or delegate tasks.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bump-version": "node scripts/bump-version.ts",
    "check-version": "node scripts/bump-version.ts --check",
    "test": "node --test --require ./tests/env-bootstrap.cjs \"tests/*.test.ts\"",
    "pretypecheck": "mkdir -p plugins/stereo/.generated/app-server-types && codex app-server generate-ts --out plugins/stereo/.generated/app-server-types",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
