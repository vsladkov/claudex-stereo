{
  "name": "claudex-stereo",
  "version": "1.26.2",
  "private": true,
  "type": "module",
  "description": "Use Codex from Claude Code to review code or delegate tasks.",
  "author": "Veselin Sladkov <veselin.sladkov@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bump-version": "node scripts/bump-version.ts",
    "check-version": "node scripts/bump-version.ts --check",
    "provider-probe": "node scripts/provider-probe.ts",
    "test": "node --test --require ./tests/env-bootstrap.cjs --test-global-setup=./tests/global-setup.ts \"tests/*.test.ts\"",
    "pretypecheck": "node -e \"fs.mkdirSync(process.argv[1], {recursive: true})\" .generated/app-server-types && codex app-server generate-ts --out .generated/app-server-types",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 100,
    "arrowParens": "always"
  },
  "lint-staged": {
    "*.{ts,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
