{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Sources run directly on Node >=24 type stripping: no emit ever, and
    // only erasable TypeScript syntax is allowed (no enums, namespaces, or
    // parameter properties).
    "noEmit": true,
    "erasableSyntaxOnly": true,
    // Bundler resolution (not NodeNext): the codegen'd .generated protocol
    // types use extensionless relative imports. Our own code still writes
    // explicit .ts extensions — Node's runtime resolver enforces that on
    // every test spawn, which is the real gate.
    "allowImportingTsExtensions": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "plugins/stereo/src/**/*.ts",
    "plugins/stereo/scripts/**/*.ts",
    "plugins/stereo/.generated/app-server-types/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
